{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "调试 tagledger 主程序 (MinGW gdb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/tagledger.exe",
            "args": [
                "--port=8080",
                "--data-dir=data",
                "--web-dir=web",
                "--config-dir=config"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:\\mingw64\\bin\\gdb.exe",
            "preLaunchTask": "构建 (MinGW Debug)",
            "setupCommands": [
                {
                    "description": "为 gdb 启用整齐打印",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "调试 tagledger_tests 单元测试 (MinGW gdb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/tagledger_tests.exe",
            "args": [
                "[unit]"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:\\mingw64\\bin\\gdb.exe",
            "preLaunchTask": "构建 (MinGW Debug)",
            "setupCommands": [
                {
                    "description": "为 gdb 启用整齐打印",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "调试 tagledger 主程序 (MSVC Debug)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build-vs/Debug/tagledger.exe",
            "args": [
                "--port=8080",
                "--data-dir=data",
                "--web-dir=web",
                "--config-dir=config"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "console": "integratedTerminal",
            "preLaunchTask": "构建 (MSVC Debug)"
        }
    ]
}
