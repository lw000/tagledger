{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "构建 (MinGW Debug)",
            "type": "shell",
            "command": "cmake-debug.bat",
            "args": ["4"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "构建 (MSVC Debug)",
            "type": "shell",
            "command": "vs-debug.bat",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": [
                "$msCompile"
            ]
        }
    ]
}
